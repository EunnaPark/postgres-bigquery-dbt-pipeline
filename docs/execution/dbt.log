    create or replace table `bigquery-access-gcp`.`dbt_dev`.`mart_annual_farm_prices`
      
    
    

    
    OPTIONS()
    as (
      

select
    extract(year from price_month) as price_year,
    geography,
    product,
    unit,
    scalar_factor,
    min(price_month) as first_month,
    max(price_month) as last_month,
    count(*) as months_present,
    12 - count(*) as months_without_records,
    count(price) as months_with_price,
    countif(price is null) as months_missing_price,
    count(price) = 12 as has_12_month_prices,
    avg(price) as avg_monthly_price
from `bigquery-access-gcp`.`dbt_dev`.`stg_farm_prices`
group by
    price_year, geography, product, unit, scalar_factor
    );
  
